/* Cloud Storage security rules, STAGE 2, 2026-11-03.
   Minimal delta over the live INTERIM TEST rules of 2026-11-02 (see
   RULES_DELTA.md). Publish to the DEFAULT bucket only
   (or-hachaim.firebasestorage.app). NEVER publish to or-hachaim-backups:
   the daily backup bucket keeps its own settings; the guard below also
   denies every client call there if this text is pasted there by mistake.

   Only /screen/ is open, as before, now for the images of the TV content
   editor (flyers, donation QR, announcement and campaign images), saved
   by the editor under screen/{type}/{itemId}/{file}.
   - Upload: super admin, or a gabbai whose sign-in token carries BOTH
     ohScreen (Content and Times, the claim the live Firestore rules read)
     AND ohImageUpload. Storage rules cannot read the Firestore users
     documents, so the claims set by the live claims function are the
     only source. Finance only (ohFinance) never uploads.
   - Limits on every upload: JPEG, PNG or WebP only, under 5 MB
     (5 * 1024 * 1024 bytes). The editor resizes to 1920 px first.
   - Delete: super admin only. The editor never deletes a file (removing
     or replacing an image only changes the item), so no gabbai needs it.
   - Read through these rules: super admin and Content and Times gabbaim
     (the editor). The public /tv/ page shows a published image through
     the download URL saved in the published content document; Cloud
     Storage serves a download URL by its token, without these rules, so
     /tv/ needs no public read rule here. A draft's URL sits in a draft
     document, which the public cannot read (Firestore rules).
   - Removed: the interim email grant of orhachaimcong (finance only now)
     and the two old interim claims (nobody has them).
   - Everything else: denied for everyone. */
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function notBackupBucket() {
      return bucket != 'or-hachaim-backups';
    }
    function isSuperAdmin() {
      return request.auth != null
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('email', '') == 'hanochhason@gmail.com';
    }
    function hasClaim(name) {
      return request.auth != null && request.auth.token.get(name, false) == true;
    }
    function canContent() {
      return isSuperAdmin() || hasClaim('ohScreen');
    }
    function canUpload() {
      return isSuperAdmin() || (hasClaim('ohScreen') && hasClaim('ohImageUpload'));
    }
    function isSmallImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp)')
        && request.resource.size < 5 * 1024 * 1024;
    }

    match /screen/{type}/{itemId}/{file} {
      allow read: if notBackupBucket() && canContent();
      allow create, update: if notBackupBucket() && canUpload() && isSmallImage();
      allow delete: if notBackupBucket() && isSuperAdmin();
    }

    /* Everything else: deny by default. */
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
